APP_BASE_URL=http://localhost:3000
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Social logins use Auth0 connection names. Create the GitHub and Google OAuth apps inside Auth0
# (callback URL = https://<tenant>.auth0.com/login/callback). The agent cannot create those secrets.
# AUTH0_CONNECTION_GITHUB=github
# AUTH0_CONNECTION_GOOGLE=google-oauth2
