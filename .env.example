APP_BASE_URL=http://localhost:3000
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Social logins use Auth0 connection names. Create the GitHub and Google OAuth apps inside Auth0
# (callback URL = https://<tenant>.auth0.com/login/callback). The agent cannot create those secrets.
# AUTH0_CONNECTION_GITHUB=github
# AUTH0_CONNECTION_GOOGLE=google-oauth2

# tarot-service-api origin for POST /spreads (BFF). Leave empty to keep the 3D deck decorative.
TAROT_BASE_URL=http://127.0.0.1:3004
HISTORY_BASE_URL=http://127.0.0.1:3005
# Same value as tarot/history when REQUIRE_SPREAD_AUTH=true
# INTERNAL_SERVICE_TOKEN=
# Browser websocket to tarot-service-api (same process, path /live). Cards only, no question text.
NEXT_PUBLIC_TAROT_WS_URL=ws://127.0.0.1:3004/live
